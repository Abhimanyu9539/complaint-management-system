# Leave VITE_API_BASE_URL unset (or set VITE_USE_MOCK=true) to run fully mocked,
# with no backend required — realistic streaming responses and localStorage sessions.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=true

# Base poll cadence for the admin panel, in ms. Panels multiply it — health
# checks 3x (they make outbound calls), Qdrant reads 2x — so lowering this
# speeds every panel up proportionally. Values below 2000 are ignored.
# VITE_ADMIN_POLL_MS=20000
