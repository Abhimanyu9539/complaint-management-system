# The admin panel is real-only: it always calls VITE_API_BASE_URL (defaulting
# to http://localhost:8000 if unset) and has no mock fallback.
VITE_API_BASE_URL=http://localhost:8000

# Chat switches independently, because no chat backend exists yet — the real
# transport calls /api/v1/chat and /sessions, which the backend does not serve.
# Leave this at true (or unset) to keep the mock: realistic streaming responses
# and localStorage-backed sessions, no backend required. Set to false only once
# a chat backend exists.
VITE_CHAT_USE_MOCK=true

# Base poll cadence for the admin panel, in ms. Panels multiply it — health
# checks 3x (they make outbound calls), Qdrant reads 2x — so lowering this
# speeds every panel up proportionally. Values below 2000 are ignored.
# VITE_ADMIN_POLL_MS=20000
