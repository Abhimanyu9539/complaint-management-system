# The admin panel is real-only: it always calls VITE_API_BASE_URL (defaulting
# to http://localhost:8000 if unset) and has no mock fallback.
VITE_API_BASE_URL=http://localhost:8000

# Chat switches independently of the base URL. False runs the real RAG graph
# over SSE at POST /api/v1/chat, which needs the backend up AND its corpus
# seeded — an empty Qdrant answers every question with the no-match message.
# True keeps the mock: canned streaming answers and localStorage sessions, no
# backend required, which is what you want for UI work.
VITE_CHAT_USE_MOCK=false

# Base poll cadence for the admin panel, in ms. Panels multiply it — health
# checks 3x (they make outbound calls), Qdrant reads 2x — so lowering this
# speeds every panel up proportionally. Values below 2000 are ignored.
# VITE_ADMIN_POLL_MS=20000

# Agent sign-in (Supabase Auth). The same project as the backend's SUPABASE_URL;
# the publishable key is safe in a browser. Without these the workbench, chat and
# admin can't be signed into — the public complaint form at /ticket still works.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
