# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_MAIN=gpt-5.4-mini
OPENAI_MODEL_CHEAP=gpt-5.4-nano

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# --- LangSmith / LangChain tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=complaint-cms

# --- Qdrant ---
# Local Docker default; use your Qdrant Cloud URL + api key instead if not running Docker.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=complaint_kb_v1

# --- Supabase (new API key system) ---
# Project Settings -> API Keys in the Supabase dashboard.
# publishable key = client-safe (replaces the old anon key); secret key = server-only (replaces service_role).
# User JWTs are verified via the JWKS endpoint derived from SUPABASE_URL, so no JWT secret is needed.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Retrieval / routing tunables ---
DEPT_CONFIDENCE_THRESHOLD=0.60
MAX_RETRIEVAL_ATTEMPTS=2

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173
