# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_MAIN=gpt-5.4-mini
OPENAI_MODEL_CHEAP=gpt-5.4-nano

# --- Embeddings ---
# EMBEDDING_DIMS sizes the Qdrant vector and truncates the model output (text-embedding-3-* only).
# Changing either of these requires `uv run cms-reindex` to rebuild the collections and re-embed.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# --- Chunking (policies only; a case is one chunk by design) ---
# Changing either re-ingests the policy corpus on the next run.
POLICY_CHUNK_TOKENS=800
POLICY_CHUNK_OVERLAP=100

# --- Retrieval ---
# Top-k per corpus. The eval suite scores at these same values.
# POLICY_TOP_K is the candidate pool the reranker sees, not what you get back —
# it is deliberately wide, and POLICY_RERANK_TOP_N is what survives.
CASE_TOP_K=4
POLICY_TOP_K=20

# --- Reranking (policies) ---
# Voyage's rerank-2.5-lite, reached through OpenRouter. VOYAGE_API_KEY is only
# needed to call Voyage directly via retrieval/rerank/voyage_reranker.py.
OPEN_ROUTER_API_KEY=sk-or-v1-...
RERANK_ENABLED=true
POLICY_RERANK_TOP_N=5

# --- LangSmith tracing ---
# These names must match the Settings fields in cms/config/settings.py (langsmith_*), not
# the legacy LANGCHAIN_* spelling — LANGSMITH_API_KEY has no default and boot fails without it.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=complaint-cms

# --- Qdrant ---
# Local Docker default; use your Qdrant Cloud URL + api key instead if not running Docker.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_CASES_COLLECTION=cases_v1
QDRANT_POLICIES_COLLECTION=policies_v1

# --- Supabase (new API key system) ---
# Project Settings -> API Keys in the Supabase dashboard.
# publishable key = client-safe (replaces the old anon key); secret key = server-only (replaces service_role).
# User JWTs are verified via the JWKS endpoint derived from SUPABASE_URL, so no JWT secret is needed.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Private Storage bucket policy files upload into; created by migration 0018.
SUPABASE_POLICY_BUCKET=policy-files

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173

# --- Seed corpus (optional) ---
# Only needed when the corpus is not at ./data/seed relative to the working directory
# or in the source tree — i.e. when re-seeding from an installed wheel in a container.
# SEED_DATA_DIR=/srv/complaint-cms/data/seed
